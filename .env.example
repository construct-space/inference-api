PORT=4300
APP_URL=http://localhost:4300
ALLOWED_ORIGINS=

# Together AI — drop your key here
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# Default model when caller doesn't specify one
DEFAULT_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct-FP8

# Hard ceiling on output tokens per request (cost safety net)
MAX_OUTPUT_TOKENS=4096

# Where skill markdown files live
SKILLS_DIR=./skills

# Where agent markdown files live (frontmatter + identity body)
AGENTS_DIR=./agents

# Web search backend. Defaults to DuckDuckGo HTML-lite (no key needed).
# Set to any DDG-compatible HTML responder or proxy if you have one.
WEB_SEARCH_URL=https://html.duckduckgo.com/html/

# Capture every prompt+completion to JSONL for finetune + analysis.
# Default ON. Set to false to kill the subsystem entirely. Per-request
# opt-out is via `capture: false` in the chat body.
CAPTURE_ENABLED=true
CAPTURE_DIR=./logs/io

# Cloudflare R2 (S3-compatible) — finalized day-files are uploaded
# hourly. Leave empty to keep logs local only.
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com
R2_BUCKET=construct-inference-logs
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
R2_PREFIX=inference/
R2_UPLOAD_EVERY=1h

# Shared with other api/* services on construct-network
INTERNAL_SHARED_SECRET=
