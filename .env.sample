R2_UPLOAD_EVERY=1h
SKILLS_DIR=./skills
AGENTS_DIR=./agents
CAPTURE_ENABLED=true
CAPTURE_DIR=./logs/io
TINKER_API_KEY=change-me
ALLOWED_ORIGINS=
NO_THINK=true
DEFAULT_MAX_TOKENS=change-me
DEFAULT_TEMPERATURE=0.3
DEFAULT_TOP_P=0.92
TRUST_PROXY_HEADERS=true
SAMPLERS={"source-medium":{"sampler":"tinker://ecb5c1cc-163f-58f4-9909-b6379c0bf558:train:0/sampler_weights/source-medium-v6-2-medium","base":"Qwen/Qwen3.6-35B-A3B"},"source-vision":{"sampler":"tinker://c51701bb-c005-54b5-8345-6f7f3ca4d86f:train:0/sampler_weights/source-vision-v0-1-vision","base":"Qwen/Qwen3-VL-30B-A3B-Instruct"}}
